# Copiar a .env y cambiar las contraseñas. .env no se sube al repositorio.
# Los valores por defecto de docker-compose.yml y de application-dev.yml son estos mismos.
POSTGRES_PASSWORD=postgres_dev
POS_DB_NAME=pos_db
POS_DB_PORT=5433
POS_OWNER_PASSWORD=pos_owner_dev
POS_APP_PASSWORD=pos_app_dev
# Contraseña temporal del usuario 'admin', creado al arrancar si no existe ningún Administrador.
# Al menos 8 caracteres, con letras y números. Solo desarrollo.
POS_ADMIN_PASSWORD_INICIAL=admin_dev_2026
# Solo backend, no expuesto por Vite
POS_BACKEND_PORT=8080
