POS_DB_NAME=pos_db
POS_DB_PORT=5433
POS_OWNER_PASSWORD=pos_owner_dev
POS_APP_PASSWORD=pos_app_dev
# Solo backend, no expuesto por Vite
POS_BACKEND_PORT=8080
